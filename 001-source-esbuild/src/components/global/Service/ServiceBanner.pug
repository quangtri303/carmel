-
    var serviceList = [
        {
            index: "1",
            title: "Khám chuyên khoa",
            desc: "Thăm khám cùng chuyên gia, bác sĩ chuyên khoa giàu kinh nghiệm cho hiệu quả điều trị tối ưu"
        },
        {
            index: "2",
            title: "Khu khám VIP",
            desc: "Không gian riêng tư, trải nghiệm dịch vụ chăm sóc sức khỏe "
        },
        {
            index: "3",
            title: "Cấp cứu 24/7",
            desc: "Ê-kíp cấp cứu phản ứng nhanh, đảm bảo an toàn cho người bệnh"
        },
        {
            index: "4",
            title: "Lọc thận",
            desc: "Hệ thống lọc thận hiện đại, đồng hành sát, đảm bảo hiệu quả điều trị"
        },
        {
            index: "5",
            title: "Gói khám cá nhân",
            desc: "Gói khám đa dạng theo nhu cầu, chăm sóc sức khỏe toàn diện"
        },
        {
            index: "6",
            title: "Gói khám doanh nghiệp",
            desc: "Giải pháp chăm sóc sức khỏe cho doanh nghiệp, nâng cao phúc lợi cho nhân viên"
        },

    ]

div(class="swiper-service relative w-full h-[calc(640/1920*100rem)] overflow-hidden")
    .service-bg
        img#service-bg-1(src="/img/service-1.png" class="active")
        img#service-bg-2(src="/img/service-2.png")
        img#service-bg-3(src="/img/service-1.png")
        img#service-bg-4(src="/img/service-2.png")
        img#service-bg-5(src="/img/service-1.png")
        img#service-bg-6(src="/img/service-2.png")
    div(class="absolute bottom-0 left-0 w-full h-full")
        .swiper(class="h-full")
            .swiper-wrapper(class="flex items-end h-full")
                each service in serviceList
                    div(class="swiper-slide" data-index=service.index)
                        .service-card
                            div(class="service-title") #{service.title}
                            .service-sep
                            .service-desc #{service.desc}
                            a.service-link(href="#")
                                div Tìm hiểu thêm
                                i.fa-thin.fa-chevron-right
                