div(class="swiper-service relative w-full aspect-[1760/640] overflow-hidden")
    div(class="swiper")
        div(class="swiper-wrapper")
            div(class="swiper-slide" 
                data-title="Khám chuyên khoa" 
                data-desc="Thăm khám cùng chuyên gia, bác sĩ chuyên khoa giàu kinh nghiệm cho hiệu quả điều trị tối ưu")
                img(src="img/service-1.png" class="w-full h-full object-cover")
            div(class="swiper-slide" 
                data-title="Khu khám VIP" 
                data-desc="Không gian riêng tư, trải nghiệm dịch vụ chăm sóc sức khỏe đẳng cấp")
                img(src="img/service-2.png" class="w-full h-full object-cover")
            div(class="swiper-slide" 
                data-title="Cấp cứu 24/7" 
                data-desc="Ê-kíp cấp cứu phản ứng nhanh, đảm bảo an toàn cho người bệnh")
                img(src="img/service-1.png" class="w-full h-full object-cover")
            div(class="swiper-slide" 
                data-title="Lọc thận" 
                data-desc="Hệ thống lọc thận hiện đại, đồng hành sát, đảm bảo hiệu quả điều trị")
                img(src="img/service-2.png" class="w-full h-full object-cover")
            div(class="swiper-slide" 
                data-title="Gói khám cá nhân" 
                data-desc="Gói khám đa dạng theo nhu cầu, chăm sóc sức khỏe toàn diện")
                img(src="img/service-1.png" class="w-full h-full object-cover")
            div(class="swiper-slide" 
                data-title="Gói khám doanh nghiệp" 
                data-desc="Giải pháp chăm sóc sức khỏe cho doanh nghiệp, nâng cao phúc lợi cho nhân viên")
                img(src="img/service-2.png" class="w-full h-full object-cover")
            
    div(class="service-pagination swiper-pagination")