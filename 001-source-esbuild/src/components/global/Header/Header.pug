                    li
                        a(href="#") Hỏi - Đáp
            li
                a(href="#") HỖ TRỢ KHÁCH HÀNG
        div(class="flex bg-Primary/1/10 rounded-20 gap-0.5 p-0.5 h-8 items-center")
            button(class="bg-Primary/1 rounded-20 px-2 py-1 rem:text-[14px] font-bold") VN
            button(class="rounded-20 text-Primary/1 px-2 py-1 rem:text-[14px]") EN
        div(class="header-search")
            input(class="" type="text" placeholder="Tìm kiếm")
            .fa-light.fa-magnifying-glass
        .fa-solid.fa-bars(class="header-hambuger text-Utility/gray-950-maintext aspect-square heading-3 block xl:hidden cursor-pointer hover:text-Primary/1 transition-colors duration-300")
    //- Mobile Menu
    ul(class="header-mobile-nav")
        li
