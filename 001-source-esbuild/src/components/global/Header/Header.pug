            li(class="group")
                a(href="#" class="group-hover:text-Primary/2") VỀ CHÚNG TÔI
                .fa-solid.fa-chevron-down(class="text-Utility/gray-950-maintext h-3 mx-2 mb-1 group-hover:rotate-180 transition-transform duration-300 aspect-square regular")
                ul(class="group-hover:opacity-100 opacity-0 invisible group-hover:visible transition-opacity duration-300")
                    li
                        a(href="#") Tầm nhìn - Sứ mệnh
                    li
                        a(href="#") Sơ đồ tổ chức
                    li
                        a(href="#") Không gian &amp; Cơ sở vật chất
                    li
                        a(href="#") Thành tựu &amp; Giải thưởng
                    li
                        a(href="#") Gia nhập đội ngũ Carmel
                    li
                        a(href="#") Cảm nhận khách hàng
            li
                a(href="#") ĐỘI NGŨ BÁC SĨ
            li
                a(href="#") CHUYÊN KHOA
            li
                a(href="#") DỊCH VỤ
            li(class="group")
                a(href="#" class="group-hover:text-Primary/2") TIN TỨC
                .fa-solid.fa-chevron-down(class="text-Utility/gray-950-maintext h-3 mx-2 mb-1 group-hover:rotate-180 transition-transform duration-300 aspect-square regular")
                ul(class="group-hover:opacity-100 opacity-0 invisible group-hover:visible transition-opacity duration-300")
                    li
                        a(href="#") Tin y tế
                    li
