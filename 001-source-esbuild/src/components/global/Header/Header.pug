header(class="bg-Utility/white min-h-27.5 w-full px-10 xl:px-40 flex flex-col md:flex-row pt-2.5 justify-between")
  img(src='/img/logo.png' class="aspect-[196.88/75] h-[calc(75/1920*100rem)] w-[calc(196.88/1920*100rem)] self-center" alt="Logo")
