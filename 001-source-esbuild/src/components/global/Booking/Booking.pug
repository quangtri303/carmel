section(class="section-booking bg-Utility/gray-50 section-py")
    .container
        div(class="flex flex-col gap-10 items-center")
            div(class="heading-1 font-semibold text-Primary/1 text-center" data-aos="fade-right") Quy trình khám bệnh
            div(class="flex flex-col xl:flex-row gap-8 w-full" data-aos="fade-up")
                ul(class="booking-step")
                    li
                        div BƯỚC 1
                        p Đặt lịch hẹn &amp; đợi xác nhận lịch hẹn
                    li
                        div BƯỚC 2
                        p Tiếp nhận &amp; sàng lọc, đánh giá tình trạng sức khỏe ban đầu
                    li
                        div BƯỚC 3
                        p Thăm khám cùng chuyên gia, bác sĩ
                    li
                        div BƯỚC 4
                        p Thực hiện cận lâm sàng bằng hệ thống trang thiết bị hiện đại
                    li
                        div BƯỚC 5
                        p Chuyên gia, bác sĩ chẩn đoán, tư vấn &amp; hướng dẫn điều trị cá thể hóa
                    li
                        div BƯỚC 6
                        p Tuân thủ điều trị, chăm sóc &amp; tái khám đúng hẹn nhằm đạt hiệu quả lâu dài
                div(class="flex flex-col lg:flex-row w-full rounded-10 overflow-hidden bg-white" data-aos="fade-left")
                    div(class="h-full w-full")
                        img(src="/img/booking.png")
                    div(class="flex flex-col w-full")
                        div(class="booking-form")
                            div(class="rem:text-[24px] text-Primary/1 font-semibold") Đặt lịch hẹn
                            
                            div(class="block-input")
                                div(class="relative w-full")
                                    input(type="text" class="peer w-full border-b border-Primary/1/40 pb-2 outline-none focus:border-Primary/1")
                                    label(class="absolute left-0 top-2 pointer-events-none transition-all duration-300 ease-out peer-focus:-translate-y-5 peer-focus:opacity-0") Họ và tên <span class="text-Utility/Error-1">*</span>

                            div(class="block-input")
                                div(class="w-full flex items-center gap-6")
                                    label(class="") Giới tính <span class="text-Utility/Error-1">*</span>
                                    div(class="flex gap-8")
                                        label(class="flex items-center gap-2 cursor-pointer")
                                            input(type="checkbox" value="1" class="peer hidden")
                                            span(class="custom-checkbox")
                                                i(class="fa-solid fa-check")
                                            span Nam

                                        label(class="flex items-center gap-2 cursor-pointer")
                                            input(type="checkbox" value="0" class="peer hidden")
                                            span(class="custom-checkbox")
                                                i(class="fa-solid fa-check")
                                            span Nữ
                            div(class="block-input")
                                div(class="relative w-full")
                                    input(type="text" class="peer w-full border-b border-Primary/1/40 pb-2 outline-none focus:border-Primary/1")
                                    label(class="absolute left-0 top-2 pointer-events-none transition-all duration-300 ease-out peer-focus:-translate-y-5 peer-focus:opacity-0") Ngày, tháng, năm sinh <span class="text-Utility/Error-1">*</span>
                                    div(class="absolute right-0 top-2 fa-regular fa-calendar")
                            div(class="block-input")
                                div(class="relative w-full")
                                    input(type="text" class="peer w-full border-b border-Primary/1/40 pb-2 outline-none focus:border-Primary/1")
                                    label(class="absolute left-0 top-2 pointer-events-none transition-all duration-300 ease-out peer-focus:-translate-y-5 peer-focus:opacity-0") Số điện thoại <span class="text-Utility/Error-1">*</span>
                            div(class="block-input")
                                div(class="relative w-full")
                                    input(type="text" class="peer w-full border-b border-Primary/1/40 pb-2 outline-none focus:border-Primary/1")
                                    label(class="absolute left-0 top-2 pointer-events-none transition-all duration-300 ease-out peer-focus:-translate-y-5 peer-focus:opacity-0") Email <span class="text-Utility/Error-1">*</span>

                            div(class="form-footer")
                                div(class="disclaimer") *Chúng tôi cam kết bảo mật thông tin của bạn.
                                    
                            button(class="self-center flex items-center justify-center gap-4 bg-Primary/1 hover:bg-Primary/2 text-white px-6 py-3 rounded-full transition-all heading-6")
                                span Đặt hẹn ngay
                                i.fa-solid.fa-chevron-right.heading-6
