div(class="swiper-hero relative w-full h-[calc(640/1920*100rem)] overflow-hidden")
    .swiper(class="h-full w-full")
        .swiper-wrapper
            .swiper-slide
                .hero-bg
                    img(src="/img/hero.png")
            .swiper-slide
                .hero-bg
                    img(src="/img/service-1.png")
            .swiper-slide
                .hero-bg 
                    img(src="/img/service-2.png")

    .pagination
        .btn-prev
            i.fa-thin.fa-chevron-left
        div
            .swiper-pagination

        .btn-next
            i.fa-thin.fa-chevron-right

    ul(class="banner-nav")
        li
            a(href="#")
                i.fa-thin.fa-user-doctor-hair
                div Tìm bác sĩ
        li
            a(href="#")
                i.fa-sharp.fa-thin.fa-calendar-circle-plus
                div Đặt lịch hẹn
        li
            a(href="#")
                i.fa-sharp.fa-light.fa-file-plus-minus
                div Xem dịch vụ
            
