section(class="section-news section overflow-y-hidden")
    .container
        div(class="flex flex-col gap-10" data-aos="fade-up")
            div(class="heading-1 font-semibold text-Primary/1 text-center") Tin tức - Hoạt động
            .overflow-x-auto
                ul(class="news-category")
                    li(class="active" data-category="medical")
                        div Tin y tế
                    li(data-category="activity")
                        div Tin tức hoạt động
                    li(data-category="medical")
                        div Y khoa thưởng thức
                    li(data-category="activity")
                        div Hỏi - Đáp
            div(class="swiper-news relative w-full" data-aos="fade-left")
                div(class="container mx-auto")
                        div(class="relative")
                            .news-content.active(data-news="medical")
                                .swiper
                                    .swiper-wrapper
                                        each item in medical
                                            .swiper-slide
                                                .news-card
                                                    div(class="news-img img-ratio ratio:pt-[220_440]")
                                                        img(src=item.img)
                                                    div(class="news-date") #{item.date}
                                                    .news-info
                                                        .news-title #{item.title}
                                                        .news-desc #{item.desc}
                                                        a(href="#" class="flex gap-2 mt-auto items-center group")
                                                            div(class="border-b-[1px] border-transparent group-hover:border-Primary/1 text-Primary/1 heading-6 transition-colors duration-300") Xem chi tiết
                                                            i.fa-thin.fa-chevron-right(class="bg-Primary/1 rounded-full text-Utility/white flex justify-center items-center h-10 w-10")
                            .news-content(data-news="activity")
                                .swiper
                                    .swiper-wrapper
                                        each item in activity
                                            .swiper-slide
                                                .news-card
                                                    div(class="news-img img-ratio ratio:pt-[220_440]")
                                                        img(src=item.img)
                                                    div(class="news-date") #{item.date}
                                                    .news-info
                                                        .news-title #{item.title}
                                                        .news-desc #{item.desc}
                                                        a(href="#" class="flex gap-2 mt-auto items-center group")
                                                            div(class="border-b-[1px] border-transparent group-hover:border-Primary/1 text-Primary/1 heading-6 transition-colors duration-300") Xem chi tiết
                                                            i.fa-thin.fa-chevron-right(class="bg-Primary/1 rounded-full text-Utility/white flex justify-center items-center h-10 w-10")
                            .btn-swiper
                                .btn-prev
                                    i.fa-thin.fa-chevron-left
                                .btn-next
                                    i.fa-thin.fa-chevron-right
